# Plantilla de variables de entorno del proyecto SASI.
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está ignorado por Git: nunca subas claves al repositorio.
#
#   cp .env.example .env.local        (Git Bash)
#   Copy-Item .env.example .env.local (PowerShell)

# --- Supabase ---
# URL del proyecto: Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave pública anónima: Supabase > Project Settings > API > anon public.
# Puede vivir en el frontend SIEMPRE que las políticas RLS estén activas.
VITE_SUPABASE_ANON_KEY=

# La clave service_role NO va aquí, ni en ningún archivo del frontend.
# Vive solo en el servidor (Edge Functions o variables de Netlify).

# --- Aplicación ---
VITE_APP_ENV=development
