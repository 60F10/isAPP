{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    /* `vite-plugin-pwa/react` es quien declara el módulo virtual
       `virtual:pwa-register/react`. Sin esta entrada, `tsc -b` no lo
       encuentra y el aviso de versión nueva no compila. */
    "types": ["vite/client", "vite-plugin-pwa/react"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Alias de importación (DOC 06 §4.3). El mismo mapa vive en vite.config.ts.
       Sin `baseUrl`: TypeScript 6 lo da por obsoleto y falla con TS5101. Las
       rutas de `paths` se resuelven contra la carpeta de este tsconfig. */
    "paths": {
      "@app/*": ["./src/app/*"],
      "@modules/*": ["./src/modules/*"],
      "@shared/*": ["./src/shared/*"],
      "@app-types/*": ["./src/types/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Comprobación estricta, escrita a mano. TypeScript 6 ya la trae
       encendida por defecto, pero se deja explícita para que no dependa de
       la versión del compilador. `noUncheckedIndexedAccess` sigue apagado a
       propósito: ver el DOC 13. */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
