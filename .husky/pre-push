# Nada de push directo a main. La proteccion de rama de GitHub no se aplica
# en repositorios privados de cuenta gratuita, asi que la garantia es esta.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo ""
    echo "  X  Push directo a main bloqueado."
    echo "     Sube tu rama y abre un pull request."
    echo ""
    exit 1
  fi
done

exit 0
